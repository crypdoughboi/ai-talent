# ── Core ──────────────────────────────────────────────────────────────
# Public base URL (used for share links, Stripe redirects, OG images)
APP_URL=http://localhost:3000

# Database (libSQL / SQLite). Local file by default; use a Turso URL in production.
DATABASE_URL=file:data/operators.db
# DATABASE_AUTH_TOKEN=            # required for Turso

# ── Admin bootstrap (used by `npm run db:seed`) ───────────────────────
ADMIN_EMAIL=admin@operators.local
ADMIN_PASSWORD=change-me-please-123

# ── AI provider (optional) ────────────────────────────────────────────
# When unset, matching and briefs use the deterministic rules engine (clearly labeled in the UI).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── Payments (optional, Stripe test mode) ─────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee in basis points (1500 = 15%)
PLATFORM_FEE_BPS=1500
# Allow clearly-labeled simulated payments when Stripe is not configured.
# Defaults to on outside production. Never enable in a real production deployment.
# PAYMENTS_SIMULATION=true
